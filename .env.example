# Database (PostgreSQL; DB_ROOT_PASSWORD is unused but kept for compatibility with older MariaDB installs)
DB_ROOT_PASSWORD=root_passwort
DB_NAME=uni_verein
DB_USER=uni_verein_user
DB_PASSWORD=passwort

# JWT
JWT_KEY=SUPER_SECRET_KEY_CHANGE_ME
JWT_ISSUER=uni-verein

# Crypto (generate distinct values for each, e.g. via `openssl rand -base64 32`)
CRYPTO_KEY=CHANGE_ME_RUN_openssl_rand_base64_32
HMAC_KEY=CHANGE_ME_RUN_openssl_rand_base64_32_DIFFERENT_FROM_CRYPTO_KEY

# Backup
BACKUP_PATH=./backup

# Frontend
VERSION=1.0.0
DEMO=false

# Demo (only for docker-compose-demo.yml)
# VERSION also selects the published images there: a release (1.4.0), latest, or a branch name (main).
# Everything the demo stores (database, receipts, logs) lives below this folder. Sample data is
# generated on start and again every night, nothing has to be put here.
#DEMO_DATA_PATH=./demo-data

# TLS (only needed if you're using docker-compose-tls.yml)
# DOMAIN must already have a DNS A/AAAA record pointing at this server.
#DOMAIN=club.example.org
#ACME_EMAIL=admin@example.org