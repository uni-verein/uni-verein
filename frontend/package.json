{
  "version": "1.0.0",
  "name": "uni-verein-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "generate-pwa-assets": "pwa-assets-generator && node -e \"const fs=require('fs');const path=require('path');for(const f of ['pwa-64x64.png','pwa-192x192.png','pwa-512x512.png','maskable-icon-512x512.png','apple-touch-icon-180x180.png','favicon.ico']){fs.renameSync(path.join('pwa',f), path.join('public',f));}\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@microsoft/signalr": "^10.0.0",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/x-charts": "^8.29.2",
    "@mui/x-date-pickers": "^8.29.5",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dayjs": "^1.11.19",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash.debounce": "^4.0.8",
    "pdfjs-dist": "^4.10.38",
    "qrcode.react": "4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^17.1.3",
    "tesseract.js": "^5.1.1",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8",
    "fast-uri": "^3.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.9.9",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
