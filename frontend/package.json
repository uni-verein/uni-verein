{
  "version": "1.0.0",
  "name": "uni-verein-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "generate-pwa-assets": "pwa-assets-generator && node -e \"const fs=require('fs');const path=require('path');for(const f of ['pwa-64x64.png','pwa-192x192.png','pwa-512x512.png','maskable-icon-512x512.png','apple-touch-icon-180x180.png','favicon.ico']){fs.renameSync(path.join('pwa',f), path.join('public',f));}\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/signalr": "^10.0.0",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/x-charts": "^8.29.2",
    "@mui/x-date-pickers": "^8.27.2",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dayjs": "^1.11.19",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "jwt-decode": "^4.0.0",
    "lodash.debounce": "^4.0.8",
    "pdfjs-dist": "^4.10.38",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^17.0.2",
    "tesseract.js": "^5.1.1",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8",
    "fast-uri": "^3.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
