# Normalize line endings to LF for everything Git considers text, regardless of the
# checking-out machine's OS or its core.autocrlf setting. The CI runners are Linux and
# Prettier is configured with endOfLine: "lf" (frontend/.prettierrc), so LF is the one
# correct line ending for this repo - this file makes local Windows checkouts match that
# instead of drifting to CRLF and tripping format/lint checks.
* text=auto eol=lf

# Explicit for the file types this repo actually has (defensive, in case auto-detection
# ever misclassifies one of them).
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.conf text eol=lf
*.editorconfig text eol=lf
Dockerfile text eol=lf

# Binary files - never touch, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.traineddata binary
